# ─── Frontend Next.js — Talents Connectés ─────────────────────────────────────
# Copier vers frontend/.env.local. Aucune variable secrète ici.

# URL interne de l'API NestJS, utilisée par le rewrite /api/v1/* (côté serveur Next uniquement)
API_URL=http://localhost:4000

# Affiche le bandeau « Environnement de démonstration — données fictives »
NEXT_PUBLIC_DEMO_MODE=true
