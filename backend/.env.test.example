# ─── Configuration des tests e2e ──────────────────────────────────────────────
# Copier vers backend/.env.test. La base DOIT se terminer par « _test » :
# elle est entièrement recréée à chaque exécution de `pnpm --filter backend test:e2e`.

NODE_ENV=test
PORT=4001
DATABASE_URL=postgresql://talents:talents_dev_password@127.0.0.1:5450/talents_connectes_test?schema=public
WEB_ORIGINS=http://localhost:3000
SESSION_COOKIE_NAME=tc_session
SESSION_TTL_HOURS=168
SESSION_SECRET=test-only-secret-not-for-production-0123456789
SWAGGER_ENABLED=false
