# ─── API NestJS — Talents Connectés ───────────────────────────────────────────
# Copier vers backend/.env puis adapter. Ne jamais committer le fichier .env.

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port HTTP de l'API
PORT=4000

# Chaîne de connexion PostgreSQL (docker compose expose 127.0.0.1:5450 par défaut)
DATABASE_URL=postgresql://talents:talents_dev_password@127.0.0.1:5450/talents_connectes?schema=public

# Origine(s) autorisée(s) du frontend, séparées par des virgules (CORS + vérification CSRF par Origin)
WEB_ORIGINS=http://localhost:3000

# Nom du cookie de session et durée de validité (heures)
SESSION_COOKIE_NAME=tc_session
SESSION_TTL_HOURS=168

# Secret serveur utilisé pour dériver le hash des jetons de session (HMAC-SHA256).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-with-a-long-random-string

# Swagger (/api/docs) : activé hors production par défaut
SWAGGER_ENABLED=true

# ─── PostgreSQL local (docker compose : backend/docker-compose.yml) ───────────
# Doivent correspondre à DATABASE_URL ci-dessus.
POSTGRES_USER=talents
POSTGRES_PASSWORD=talents_dev_password
POSTGRES_DB=talents_connectes
POSTGRES_PORT=5450

# Visio : base des liens de réunion générés à la confirmation d’une séance à distance.
# Service externe (Jitsi Meet par défaut). Laisser vide pour désactiver la génération.
MEETING_BASE_URL=https://meet.jit.si

# ─── Appels audio et vidéo (WebRTC, pair à pair) ──────────────────────────────
# Sans serveur configuré, les appels fonctionnent entre appareils d'un même réseau local.
# Pour les réseaux mobiles (NAT), ajouter un relais TURN : `docker compose --profile calls up -d`
# démarre coturn (voir docker-compose.yml). Remplacer 127.0.0.1 par l'IP publique du serveur.
# STUN_URLS=stun:127.0.0.1:3478
# TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
# TURN_SECRET=change-me-turn-secret-partage-avec-coturn

# ─── Assistance par IA (facultative) ──────────────────────────────────────────
# Sans clé, les boutons d'IA sont masqués et le reste de la plateforme fonctionne normalement.
# La clé reste côté serveur. Fixez aussi une limite de dépense dans votre compte OpenAI.
# OPENAI_API_KEY=
# Modèle retenu après évaluation (pnpm --filter backend ai:eval -- <modèles>).
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_REASONING_EFFORT=low
# AI_USER_DAILY_LIMIT=30
# AI_GLOBAL_DAILY_LIMIT=1000
# AI_ASSISTANT_DAILY_LIMIT=60
