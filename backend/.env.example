# ─── API NestJS — Talents Connectés ───────────────────────────────────────────
# Copier vers backend/.env puis adapter. Ne jamais committer le fichier .env.

# Environnement d'exécution : development | test | production
NODE_ENV=development

# Port HTTP de l'API
PORT=4000

# Chaîne de connexion PostgreSQL (docker compose expose 127.0.0.1:5450 par défaut)
DATABASE_URL=postgresql://talents:talents_dev_password@127.0.0.1:5450/talents_connectes?schema=public

# Origine(s) autorisée(s) du frontend, séparées par des virgules (CORS + vérification CSRF par Origin)
WEB_ORIGINS=http://localhost:3000

# Nom du cookie de session et durée de validité (heures)
SESSION_COOKIE_NAME=tc_session
SESSION_TTL_HOURS=168

# Secret serveur utilisé pour dériver le hash des jetons de session (HMAC-SHA256).
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-with-a-long-random-string

# Swagger (/api/docs) : activé hors production par défaut
SWAGGER_ENABLED=true

# ─── PostgreSQL local (docker compose : backend/docker-compose.yml) ───────────
# Doivent correspondre à DATABASE_URL ci-dessus.
POSTGRES_USER=talents
POSTGRES_PASSWORD=talents_dev_password
POSTGRES_DB=talents_connectes
POSTGRES_PORT=5450
