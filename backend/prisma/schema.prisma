// Talents Connectés — modèle de données PostgreSQL
// Conventions : modèles/champs en camelCase côté Prisma, tables/colonnes en snake_case côté SQL.
// Toutes les dates sont stockées en UTC (timestamptz).
// Contraintes avancées (index partiels, exclusion anti-chevauchement) : voir les migrations SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Énumérations ────────────────────────────────────────────────────────────

enum Role {
  MENTEE
  MENTOR
  ADMIN
  /// Responsable de la plateforme : droits d'administrateur, plus la gestion de l'équipe, le journal d'audit et la révocation des certificats.
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Compte supprimé à la demande de l'utilisateur : données personnelles anonymisées.
  DELETED
}

enum OpportunityType {
  INTERNSHIP
  JOB
  CALL_FOR_PROJECTS
  SCHOLARSHIP
  TRAINING
  EVENT
  OTHER
}

enum Modality {
  REMOTE
  IN_PERSON
  HYBRID
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum MenteeSituation {
  STUDENT
  GRADUATE
  ENTREPRENEUR
  PROJECT_HOLDER
  CAREER_CHANGE
  PROFESSIONAL
  OTHER
}

enum MentorshipRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MentorshipStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ResourceKind {
  ARTICLE
  VIDEO
  TEMPLATE
  TOOL
  ADVICE
  OTHER
}

enum NotificationType {
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  SESSION_REQUESTED
  SESSION_CONFIRMED
  SESSION_CANCELLED
  GOAL_FEEDBACK
  RESOURCE_SHARED
  MENTORSHIP_COMPLETED
  CERTIFICATE_ISSUED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── Identité & authentification ─────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name") @db.VarChar(80)
  lastName        String     @map("last_name") @db.VarChar(80)
  role            Role
  status          UserStatus @default(ACTIVE)
  timezone        String     @default("Africa/Conakry") @db.VarChar(64)
  onboardedAt     DateTime?  @map("onboarded_at") @db.Timestamptz(3)
  /// Date de la dernière photo de profil (null = aucune) : sert aussi de clé de cache côté client.
  avatarUpdatedAt DateTime?  @map("avatar_updated_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      AuthSession[]
  avatar        UserAvatar?
  mentorProfile MentorProfile?
  menteeProfile MenteeProfile?

  sentRequests     MentorshipRequest[] @relation("RequestMentee")
  receivedRequests MentorshipRequest[] @relation("RequestMentor")

  mentorshipsAsMentor Mentorship[] @relation("MentorshipMentor")
  mentorshipsAsMentee Mentorship[] @relation("MentorshipMentee")

  availabilitySlots AvailabilitySlot[]
  sessionsAsMentor  MentoringSession[] @relation("SessionMentor")
  sessionsAsMentee  MentoringSession[] @relation("SessionMentee")

  messages         Message[]
  goalsCreated     Goal[]
  sessionFeedbacks SessionFeedback[]
  resources        Resource[]
  notifications    Notification[]
  opportunities    Opportunity[]

  certificatesAsMentor MentorshipCertificate[] @relation("CertificateMentor")
  certificatesAsMentee MentorshipCertificate[] @relation("CertificateMentee")
  auditEntries         AuditLog[]

  @@index([role, status])
  @@map("users")
}

/// Photo de profil (recadrée et réduite par le navigateur). Taille et type bornés par des CHECK SQL.
model UserAvatar {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String   @map("mime_type") @db.VarChar(32)
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_avatars")
}

/// Session d'authentification opaque : seul le hash SHA-256 du jeton est stocké.
model AuthSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// ─── Catalogue des domaines (issus des TDR, section 5) ───────────────────────

model ExpertiseDomain {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String
  icon        String   @db.VarChar(40)
  topics      String[]
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentors       MentorDomain[]
  mentees       MenteeInterest[]
  requests      MentorshipRequest[]
  resources     Resource[]
  opportunities Opportunity[]

  @@map("expertise_domains")
}

// ─── Profils ─────────────────────────────────────────────────────────────────

model MentorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique @map("user_id")
  headline           String             @db.VarChar(140)
  bio                String
  currentPosition    String?            @map("current_position") @db.VarChar(120)
  organization       String?            @db.VarChar(120)
  yearsExperience    Int                @map("years_experience")
  expertise          String[]
  languages          String[]
  modalities         Modality[]
  city               String?            @db.VarChar(80)
  sessionDurationMin Int                @default(60) @map("session_duration_min")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  isPublished        Boolean            @default(true) @map("is_published")
  /// Texte de recherche normalisé (minuscules, sans accents) : titre, expertises, domaines, nom.
  searchText         String             @default("") @map("search_text")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domains MentorDomain[]

  @@index([isPublished, verificationStatus])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "mentor_profiles_search_text_trgm")
  @@map("mentor_profiles")
}

model MentorDomain {
  mentorProfileId String @map("mentor_profile_id")
  domainId        String @map("domain_id")

  mentorProfile MentorProfile   @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  domain        ExpertiseDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@id([mentorProfileId, domainId])
  @@index([domainId])
  @@map("mentor_domains")
}

model MenteeProfile {
  id                String          @id @default(cuid())
  userId            String          @unique @map("user_id")
  situation         MenteeSituation
  goalsSummary      String          @map("goals_summary")
  desiredSkills     String[]        @map("desired_skills")
  preferredModality Modality        @map("preferred_modality")
  city              String?         @db.VarChar(80)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests MenteeInterest[]

  @@map("mentee_profiles")
}

model MenteeInterest {
  menteeProfileId String @map("mentee_profile_id")
  domainId        String @map("domain_id")

  menteeProfile MenteeProfile   @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  domain        ExpertiseDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@id([menteeProfileId, domainId])
  @@index([domainId])
  @@map("mentee_interests")
}

// ─── Mise en relation ────────────────────────────────────────────────────────

/// Invariant (index partiel SQL) : une seule demande PENDING par couple mentoré/mentor.
model MentorshipRequest {
  id           String                  @id @default(cuid())
  menteeId     String                  @map("mentee_id")
  mentorId     String                  @map("mentor_id")
  domainId     String?                 @map("domain_id")
  goal         String                  @db.VarChar(200)
  message      String
  status       MentorshipRequestStatus @default(PENDING)
  decisionNote String?                 @map("decision_note") @db.VarChar(500)
  respondedAt  DateTime?               @map("responded_at") @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentee     User             @relation("RequestMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor     User             @relation("RequestMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  domain     ExpertiseDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  mentorship Mentorship?

  @@index([mentorId, status, createdAt])
  @@index([menteeId, status, createdAt])
  @@map("mentorship_requests")
}

/// Créé de façon idempotente à l'acceptation (requestId unique).
/// Invariant (index partiel SQL) : un seul mentorat ACTIVE par couple.
model Mentorship {
  id        String           @id @default(cuid())
  requestId String           @unique @map("request_id")
  mentorId  String           @map("mentor_id")
  menteeId  String           @map("mentee_id")
  status    MentorshipStatus @default(ACTIVE)
  startedAt DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?        @map("ended_at") @db.Timestamptz(3)
  endedById String?          @map("ended_by_id")
  /// Bilan facultatif rédigé à la clôture.
  endNote   String?          @map("end_note") @db.VarChar(1000)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  request     MentorshipRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  mentor      User                   @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee      User                   @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  sessions    MentoringSession[]
  messages    Message[]
  goals       Goal[]
  resources   Resource[]
  certificate MentorshipCertificate?

  @@index([mentorId, status])
  @@index([menteeId, status])
  @@map("mentorships")
}

/// Certificat d'accompagnement délivré au mentor à la clôture d'un mentorat ayant au moins une
/// séance réalisée. Les chiffres sont figés au moment de la délivrance ; le code permet à
/// quiconque de vérifier le certificat. Invariants (CHECK SQL) : au moins une séance, dates cohérentes.
model MentorshipCertificate {
  id                String    @id @default(cuid())
  code              String    @unique @db.VarChar(16)
  mentorshipId      String    @unique @map("mentorship_id")
  mentorId          String    @map("mentor_id")
  menteeId          String    @map("mentee_id")
  /// Nom complet du mentor et prénom + initiale du mentoré (minimisation des données publiques).
  mentorName        String    @map("mentor_name") @db.VarChar(170)
  menteeName        String    @map("mentee_name") @db.VarChar(100)
  domainName        String    @map("domain_name") @db.VarChar(120)
  startedAt         DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime  @map("ended_at") @db.Timestamptz(3)
  completedSessions Int       @map("completed_sessions")
  totalMinutes      Int       @map("total_minutes")
  goalsCompleted    Int       @map("goals_completed")
  goalsTotal        Int       @map("goals_total")
  /// Moyenne des évaluations laissées par le mentoré (null s'il n'a rien évalué).
  averageRating     Float?    @map("average_rating")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  /// Renseignée si le compte du mentor est supprimé : le certificat n'est plus valide.
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Motif de la révocation (suppression du compte ou décision de l'équipe).
  revokedReason     String?   @map("revoked_reason") @db.VarChar(300)

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentor     User       @relation("CertificateMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee     User       @relation("CertificateMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([mentorId, issuedAt])
  @@map("mentorship_certificates")
}

/// Journal d'audit des actions de l'équipe (modération, rôles, certificats). Jamais le contenu des conversations.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  /// Nom de l'auteur au moment de l'action (conservé si le compte disparaît).
  actorName  String   @map("actor_name") @db.VarChar(170)
  action     String   @db.VarChar(60)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String?  @map("target_id")
  summary    String   @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Disponibilités & séances ────────────────────────────────────────────────

/// Invariant (contrainte d'exclusion SQL) : pas de chevauchement de créneaux actifs pour un mentor.
model AvailabilitySlot {
  id        String   @id @default(cuid())
  mentorId  String   @map("mentor_id")
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  timezone  String   @default("Africa/Conakry") @db.VarChar(64)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentor   User               @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  sessions MentoringSession[]

  @@index([mentorId, startsAt])
  @@map("availability_slots")
}

/// Invariants (SQL) : un créneau ne porte qu'une séance REQUESTED/CONFIRMED,
/// et un mentor n'a jamais deux séances actives qui se chevauchent.
model MentoringSession {
  id           String        @id @default(cuid())
  mentorshipId String        @map("mentorship_id")
  mentorId     String        @map("mentor_id")
  menteeId     String        @map("mentee_id")
  slotId       String?       @map("slot_id")
  startsAt     DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime      @map("ends_at") @db.Timestamptz(3)
  status       SessionStatus @default(REQUESTED)
  topic        String        @db.VarChar(200)
  modality     Modality      @default(REMOTE)
  meetingUrl   String?       @map("meeting_url") @db.VarChar(500)
  location     String?       @db.VarChar(200)
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy  String?       @map("cancelled_by")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentorship Mentorship        @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentor     User              @relation("SessionMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee     User              @relation("SessionMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  slot       AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  feedbacks  SessionFeedback[]

  @@index([mentorId, startsAt])
  @@index([menteeId, startsAt])
  @@index([mentorshipId])
  @@map("mentoring_sessions")
}

/// Évaluation d'une séance terminée : une seule par participant (note 1–5, contrainte CHECK en SQL).
model SessionFeedback {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  authorId  String   @map("author_id")
  rating    Int
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session MentoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([sessionId, authorId])
  @@index([authorId])
  @@map("session_feedbacks")
}

// ─── Ressources & notifications ─────────────────────────────────────────────

/// Ressource partagée (lien et/ou conseil rédigé ; pas de dépôt de fichiers dans le MVP).
/// mentorshipId null  → bibliothèque publique (publiée par un mentor ou un admin) ;
/// mentorshipId défini → visible des seuls participants de ce mentorat.
model Resource {
  id           String       @id @default(cuid())
  authorId     String       @map("author_id")
  mentorshipId String?      @map("mentorship_id")
  domainId     String?      @map("domain_id")
  kind         ResourceKind @default(OTHER)
  title        String       @db.VarChar(160)
  description  String?      @db.VarChar(2000)
  url          String?      @db.VarChar(500)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentorship Mentorship?      @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  domain     ExpertiseDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([mentorshipId, createdAt])
  @@index([domainId, createdAt])
  @@map("resources")
}

/// Notification in-app : uniquement des événements réels ; lien relatif vers l'écran concerné.
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String?          @db.VarChar(500)
  link      String?          @db.VarChar(300)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Opportunité professionnelle ou entrepreneuriale (TDR §7.2), publiée par un mentor ou un admin.
/// L'archivage (archivedAt) la retire de la liste publique sans perdre l'historique.
model Opportunity {
  id           String          @id @default(cuid())
  authorId     String          @map("author_id")
  domainId     String?         @map("domain_id")
  type         OpportunityType
  title        String          @db.VarChar(160)
  organization String          @db.VarChar(120)
  description  String          @db.VarChar(3000)
  location     String?         @db.VarChar(120)
  isRemote     Boolean         @default(false) @map("is_remote")
  url          String?         @db.VarChar(500)
  deadline     DateTime?       @db.Timestamptz(3)
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  domain ExpertiseDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([archivedAt, deadline])
  @@index([type, createdAt])
  @@index([domainId])
  @@map("opportunities")
}

// ─── Échanges ────────────────────────────────────────────────────────────────

/// La conversation est portée par le mentorat : seuls ses deux participants y accèdent.
model Message {
  id           String    @id @default(cuid())
  mentorshipId String    @map("mentorship_id")
  senderId     String    @map("sender_id")
  content      String
  readAt       DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  sender     User       @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([mentorshipId, createdAt])
  @@map("messages")
}

// ─── Objectifs & progression ────────────────────────────────────────────────

model Goal {
  id             String     @id @default(cuid())
  mentorshipId   String     @map("mentorship_id")
  createdById    String     @map("created_by_id")
  title          String     @db.VarChar(160)
  description    String?
  status         GoalStatus @default(NOT_STARTED)
  progress       Int        @default(0)
  dueDate        DateTime?  @map("due_date") @db.Timestamptz(3)
  mentorFeedback String?    @map("mentor_feedback")
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentorship Mentorship  @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([mentorshipId])
  @@map("goals")
}

model Milestone {
  id        String    @id @default(cuid())
  goalId    String    @map("goal_id")
  title     String    @db.VarChar(160)
  isDone    Boolean   @default(false) @map("is_done")
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, sortOrder])
  @@map("milestones")
}
