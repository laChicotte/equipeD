// TalentsConnect — modèle de données PostgreSQL
// Conventions : modèles/champs en camelCase côté Prisma, tables/colonnes en snake_case côté SQL.
// Toutes les dates sont stockées en UTC (timestamptz).
// Contraintes avancées (index partiels, exclusion anti-chevauchement) : voir les migrations SQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ─── Énumérations ────────────────────────────────────────────────────────────

enum Role {
  MENTEE
  MENTOR
  /// Équipe de la plateforme : modération, vérification des profils, pilotage, équipe, journal d'audit.
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Compte supprimé à la demande de l'utilisateur : données personnelles anonymisées.
  DELETED
}

enum OpportunityType {
  INTERNSHIP
  JOB
  CALL_FOR_PROJECTS
  SCHOLARSHIP
  TRAINING
  EVENT
  OTHER
}

enum Modality {
  REMOTE
  IN_PERSON
  HYBRID
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

/// Vérification d'un profil mentor existant, ou candidature d'un mentoré pour devenir mentor.
enum VerificationKind {
  MENTOR_VERIFICATION
  MENTOR_APPLICATION
}

enum VerificationRequestStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum MenteeSituation {
  STUDENT
  GRADUATE
  ENTREPRENEUR
  PROJECT_HOLDER
  CAREER_CHANGE
  PROFESSIONAL
  OTHER
}

enum MentorshipRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum MentorshipStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  REQUESTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum ResourceKind {
  ARTICLE
  VIDEO
  TEMPLATE
  TOOL
  ADVICE
  OTHER
}

enum NotificationType {
  REQUEST_RECEIVED
  REQUEST_ACCEPTED
  REQUEST_DECLINED
  SESSION_REQUESTED
  SESSION_CONFIRMED
  SESSION_CANCELLED
  GOAL_FEEDBACK
  RESOURCE_SHARED
  MENTORSHIP_COMPLETED
  CERTIFICATE_ISSUED
  GROUP_ADDED
  WORKSHOP_SCHEDULED
  WORKSHOP_CANCELLED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
}

/// Réponse d'un membre à l'invitation à un atelier.
enum WorkshopResponse {
  GOING
  NOT_GOING
}

enum CallKind {
  AUDIO
  VIDEO
}

/// RINGING → ACTIVE → ENDED ; ou RINGING → MISSED (sans réponse), DECLINED, CANCELLED (l'appelant raccroche).
enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  DECLINED
  CANCELLED
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// ─── Identité & authentification ─────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String     @map("password_hash")
  firstName       String     @map("first_name") @db.VarChar(80)
  lastName        String     @map("last_name") @db.VarChar(80)
  role            Role
  status          UserStatus @default(ACTIVE)
  timezone        String     @default("Africa/Conakry") @db.VarChar(64)
  onboardedAt     DateTime?  @map("onboarded_at") @db.Timestamptz(3)
  /// Date de la dernière photo de profil (null = aucune) : sert aussi de clé de cache côté client.
  avatarUpdatedAt DateTime?  @map("avatar_updated_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      AuthSession[]
  avatar        UserAvatar?
  mentorProfile MentorProfile?
  menteeProfile MenteeProfile?

  sentRequests     MentorshipRequest[] @relation("RequestMentee")
  receivedRequests MentorshipRequest[] @relation("RequestMentor")

  mentorshipsAsMentor Mentorship[] @relation("MentorshipMentor")
  mentorshipsAsMentee Mentorship[] @relation("MentorshipMentee")

  availabilitySlots AvailabilitySlot[]
  sessionsAsMentor  MentoringSession[] @relation("SessionMentor")
  sessionsAsMentee  MentoringSession[] @relation("SessionMentee")

  messages         Message[]
  goalsCreated     Goal[]
  sessionFeedbacks SessionFeedback[]
  resources        Resource[]
  notifications    Notification[]
  opportunities    Opportunity[]

  certificatesAsMentor MentorshipCertificate[] @relation("CertificateMentor")
  certificatesAsMentee MentorshipCertificate[] @relation("CertificateMentee")
  auditEntries         AuditLog[]

  ownedGroups      MentoringGroup[] @relation("GroupOwner")
  groupMemberships GroupMember[]
  groupMessages    GroupMessage[]

  callsMade     Call[] @relation("CallCaller")
  callsReceived Call[] @relation("CallCallee")

  verificationRequests  VerificationRequest[] @relation("VerificationApplicant")
  verificationDecisions VerificationRequest[] @relation("VerificationReviewer")

  workshopsCreated    GroupWorkshop[]
  workshopAttendances WorkshopAttendance[]
  passwordResets      PasswordResetToken[]

  @@index([role, status])
  @@map("users")
}

/// Photo de profil (recadrée et réduite par le navigateur). Taille et type bornés par des CHECK SQL.
model UserAvatar {
  userId    String   @id @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mimeType  String   @map("mime_type") @db.VarChar(32)
  data      Bytes
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("user_avatars")
}

/// Session d'authentification opaque : seul le hash SHA-256 du jeton est stocké.
model AuthSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

/// Lien de réinitialisation du mot de passe, à usage unique et de courte durée.
/// Émis par l'équipe (aucun email n'est envoyé par la plateforme pour l'instant) : seul le hash
/// HMAC du jeton est stocké, comme pour les sessions.
model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime? @map("used_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_reset_tokens")
}

// ─── Catalogue des domaines (issus des TDR, section 5) ───────────────────────

model ExpertiseDomain {
  id          String   @id @default(cuid())
  slug        String   @unique @db.VarChar(80)
  name        String   @db.VarChar(120)
  description String
  icon        String   @db.VarChar(40)
  topics      String[]
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentors       MentorDomain[]
  mentees       MenteeInterest[]
  requests      MentorshipRequest[]
  resources     Resource[]
  opportunities Opportunity[]

  @@map("expertise_domains")
}

// ─── Profils ─────────────────────────────────────────────────────────────────

model MentorProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique @map("user_id")
  headline           String             @db.VarChar(140)
  bio                String
  currentPosition    String?            @map("current_position") @db.VarChar(120)
  organization       String?            @db.VarChar(120)
  yearsExperience    Int                @map("years_experience")
  expertise          String[]
  languages          String[]
  modalities         Modality[]
  city               String?            @db.VarChar(80)
  sessionDurationMin Int                @default(60) @map("session_duration_min")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  isPublished        Boolean            @default(true) @map("is_published")
  /// Texte de recherche normalisé (minuscules, sans accents) : titre, expertises, domaines, nom.
  searchText         String             @default("") @map("search_text")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domains MentorDomain[]

  @@index([isPublished, verificationStatus])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "mentor_profiles_search_text_trgm")
  @@map("mentor_profiles")
}

model MentorDomain {
  mentorProfileId String @map("mentor_profile_id")
  domainId        String @map("domain_id")

  mentorProfile MentorProfile   @relation(fields: [mentorProfileId], references: [id], onDelete: Cascade)
  domain        ExpertiseDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@id([mentorProfileId, domainId])
  @@index([domainId])
  @@map("mentor_domains")
}

model MenteeProfile {
  id                String          @id @default(cuid())
  userId            String          @unique @map("user_id")
  situation         MenteeSituation
  goalsSummary      String          @map("goals_summary")
  desiredSkills     String[]        @map("desired_skills")
  preferredModality Modality        @map("preferred_modality")
  city              String?         @db.VarChar(80)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interests MenteeInterest[]

  @@map("mentee_profiles")
}

model MenteeInterest {
  menteeProfileId String @map("mentee_profile_id")
  domainId        String @map("domain_id")

  menteeProfile MenteeProfile   @relation(fields: [menteeProfileId], references: [id], onDelete: Cascade)
  domain        ExpertiseDomain @relation(fields: [domainId], references: [id], onDelete: Restrict)

  @@id([menteeProfileId, domainId])
  @@index([domainId])
  @@map("mentee_interests")
}

// ─── Mise en relation ────────────────────────────────────────────────────────

/// Invariant (index partiel SQL) : une seule demande PENDING par couple mentoré/mentor.
model MentorshipRequest {
  id           String                  @id @default(cuid())
  menteeId     String                  @map("mentee_id")
  mentorId     String                  @map("mentor_id")
  domainId     String?                 @map("domain_id")
  goal         String                  @db.VarChar(200)
  message      String
  status       MentorshipRequestStatus @default(PENDING)
  decisionNote String?                 @map("decision_note") @db.VarChar(500)
  respondedAt  DateTime?               @map("responded_at") @db.Timestamptz(3)
  createdAt    DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentee     User             @relation("RequestMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor     User             @relation("RequestMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  domain     ExpertiseDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  mentorship Mentorship?

  @@index([mentorId, status, createdAt])
  @@index([menteeId, status, createdAt])
  @@map("mentorship_requests")
}

/// Créé de façon idempotente à l'acceptation (requestId unique).
/// Invariant (index partiel SQL) : un seul mentorat ACTIVE par couple.
model Mentorship {
  id        String           @id @default(cuid())
  requestId String           @unique @map("request_id")
  mentorId  String           @map("mentor_id")
  menteeId  String           @map("mentee_id")
  status    MentorshipStatus @default(ACTIVE)
  startedAt DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?        @map("ended_at") @db.Timestamptz(3)
  endedById String?          @map("ended_by_id")
  /// Bilan facultatif rédigé à la clôture.
  endNote   String?          @map("end_note") @db.VarChar(1000)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  request     MentorshipRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  mentor      User                   @relation("MentorshipMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee      User                   @relation("MentorshipMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  sessions    MentoringSession[]
  messages    Message[]
  calls       Call[]
  goals       Goal[]
  resources   Resource[]
  certificate MentorshipCertificate?

  @@index([mentorId, status])
  @@index([menteeId, status])
  @@map("mentorships")
}

/// Certificat d'accompagnement délivré au mentor à la clôture d'un mentorat ayant au moins une
/// séance réalisée. Les chiffres sont figés au moment de la délivrance ; le code permet à
/// quiconque de vérifier le certificat. Invariants (CHECK SQL) : au moins une séance, dates cohérentes.
model MentorshipCertificate {
  id                String    @id @default(cuid())
  code              String    @unique @db.VarChar(16)
  mentorshipId      String    @unique @map("mentorship_id")
  mentorId          String    @map("mentor_id")
  menteeId          String    @map("mentee_id")
  /// Nom complet du mentor et prénom + initiale du mentoré (minimisation des données publiques).
  mentorName        String    @map("mentor_name") @db.VarChar(170)
  menteeName        String    @map("mentee_name") @db.VarChar(100)
  domainName        String    @map("domain_name") @db.VarChar(120)
  startedAt         DateTime  @map("started_at") @db.Timestamptz(3)
  endedAt           DateTime  @map("ended_at") @db.Timestamptz(3)
  completedSessions Int       @map("completed_sessions")
  totalMinutes      Int       @map("total_minutes")
  goalsCompleted    Int       @map("goals_completed")
  goalsTotal        Int       @map("goals_total")
  /// Moyenne des évaluations laissées par le mentoré (null s'il n'a rien évalué).
  averageRating     Float?    @map("average_rating")
  issuedAt          DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  /// Renseignée si le compte du mentor est supprimé : le certificat n'est plus valide.
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  /// Motif de la révocation (suppression du compte ou décision de l'équipe).
  revokedReason     String?   @map("revoked_reason") @db.VarChar(300)

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentor     User       @relation("CertificateMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee     User       @relation("CertificateMentee", fields: [menteeId], references: [id], onDelete: Cascade)

  @@index([mentorId, issuedAt])
  @@map("mentorship_certificates")
}

/// Journal d'audit des actions de l'équipe (modération, rôles, certificats). Jamais le contenu des conversations.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  /// Nom de l'auteur au moment de l'action (conservé si le compte disparaît).
  actorName  String   @map("actor_name") @db.VarChar(170)
  action     String   @db.VarChar(60)
  targetType String   @map("target_type") @db.VarChar(40)
  targetId   String?  @map("target_id")
  summary    String   @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Disponibilités & séances ────────────────────────────────────────────────

/// Invariant (contrainte d'exclusion SQL) : pas de chevauchement de créneaux actifs pour un mentor.
model AvailabilitySlot {
  id        String   @id @default(cuid())
  mentorId  String   @map("mentor_id")
  startsAt  DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime @map("ends_at") @db.Timestamptz(3)
  timezone  String   @default("Africa/Conakry") @db.VarChar(64)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentor   User               @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  sessions MentoringSession[]

  @@index([mentorId, startsAt])
  @@map("availability_slots")
}

/// Invariants (SQL) : un créneau ne porte qu'une séance REQUESTED/CONFIRMED,
/// et un mentor n'a jamais deux séances actives qui se chevauchent.
model MentoringSession {
  id           String        @id @default(cuid())
  mentorshipId String        @map("mentorship_id")
  mentorId     String        @map("mentor_id")
  menteeId     String        @map("mentee_id")
  slotId       String?       @map("slot_id")
  startsAt     DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime      @map("ends_at") @db.Timestamptz(3)
  status       SessionStatus @default(REQUESTED)
  topic        String        @db.VarChar(200)
  modality     Modality      @default(REMOTE)
  meetingUrl   String?       @map("meeting_url") @db.VarChar(500)
  location     String?       @db.VarChar(200)
  confirmedAt  DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt  DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy  String?       @map("cancelled_by")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentorship Mentorship        @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  mentor     User              @relation("SessionMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee     User              @relation("SessionMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  slot       AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  feedbacks  SessionFeedback[]

  @@index([mentorId, startsAt])
  @@index([menteeId, startsAt])
  @@index([mentorshipId])
  @@map("mentoring_sessions")
}

/// Évaluation d'une séance terminée : une seule par participant (note 1–5, contrainte CHECK en SQL).
model SessionFeedback {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  authorId  String   @map("author_id")
  rating    Int
  comment   String?  @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  session MentoringSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([sessionId, authorId])
  @@index([authorId])
  @@map("session_feedbacks")
}

// ─── Ressources & notifications ─────────────────────────────────────────────

/// Ressource partagée (lien et/ou conseil rédigé ; pas de dépôt de fichiers dans le MVP).
/// mentorshipId null  → bibliothèque publique (publiée par un mentor ou un admin) ;
/// mentorshipId défini → visible des seuls participants de ce mentorat.
model Resource {
  id           String       @id @default(cuid())
  authorId     String       @map("author_id")
  mentorshipId String?      @map("mentorship_id")
  domainId     String?      @map("domain_id")
  kind         ResourceKind @default(OTHER)
  title        String       @db.VarChar(160)
  description  String?      @db.VarChar(2000)
  url          String?      @db.VarChar(500)
  /// Vrai si un document est joint (ResourceFile) : permet la contrainte « lien, texte ou document ».
  hasFile      Boolean      @default(false) @map("has_file")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  author     User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentorship Mentorship?      @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  domain     ExpertiseDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)
  file       ResourceFile?

  @@index([mentorshipId, createdAt])
  @@index([domainId, createdAt])
  @@map("resources")
}

/// Document joint à une ressource (PDF, Word, Excel, PowerPoint, image, texte), 10 Mo au plus.
/// Stocké à part pour que les listes de ressources restent légères. Type et taille bornés par des CHECK SQL.
model ResourceFile {
  resourceId String   @id @map("resource_id")
  fileName   String   @map("file_name") @db.VarChar(200)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  size       Int
  data       Bytes
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("resource_files")
}

/// Notification in-app : uniquement des événements réels ; lien relatif vers l'écran concerné.
model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String?          @db.VarChar(500)
  link      String?          @db.VarChar(300)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

/// Opportunité professionnelle ou entrepreneuriale (TDR §7.2), publiée par un mentor ou un admin.
/// L'archivage (archivedAt) la retire de la liste publique sans perdre l'historique.
model Opportunity {
  id           String          @id @default(cuid())
  authorId     String          @map("author_id")
  domainId     String?         @map("domain_id")
  type         OpportunityType
  title        String          @db.VarChar(160)
  organization String          @db.VarChar(120)
  description  String          @db.VarChar(3000)
  location     String?         @db.VarChar(120)
  isRemote     Boolean         @default(false) @map("is_remote")
  url          String?         @db.VarChar(500)
  deadline     DateTime?       @db.Timestamptz(3)
  archivedAt   DateTime?       @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  author User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  domain ExpertiseDomain? @relation(fields: [domainId], references: [id], onDelete: SetNull)

  @@index([archivedAt, deadline])
  @@index([type, createdAt])
  @@index([domainId])
  @@map("opportunities")
}

// ─── Échanges ────────────────────────────────────────────────────────────────

/// La conversation est portée par le mentorat : seuls ses deux participants y accèdent.
model Message {
  id           String    @id @default(cuid())
  mentorshipId String    @map("mentorship_id")
  senderId     String    @map("sender_id")
  /// Vide si le message ne porte qu'une pièce jointe ou un compte rendu d'appel.
  content      String
  /// Vrai si une pièce jointe est stockée dans message_files.
  hasFile      Boolean   @default(false) @map("has_file")
  /// Identifiant choisi par le navigateur : un message renvoyé après une coupure n'est pas dupliqué.
  clientId     String?   @map("client_id") @db.VarChar(64)
  /// Compte rendu d'appel (« Appel vidéo · 3 min », « Appel manqué ») inscrit dans le fil.
  callId       String?   @unique @map("call_id")
  readAt       DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  mentorship Mentorship   @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  sender     User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  file       MessageFile?
  call       Call?        @relation(fields: [callId], references: [id], onDelete: SetNull)

  @@unique([senderId, clientId])
  @@index([mentorshipId, createdAt])
  @@map("messages")
}

/// Pièce jointe d'un message privé (mêmes formats et limites que les documents des ressources).
model MessageFile {
  messageId String   @id @map("message_id")
  fileName  String   @map("file_name") @db.VarChar(200)
  mimeType  String   @map("mime_type") @db.VarChar(120)
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_files")
}

/// Appel audio ou vidéo entre les deux participants d'un mentorat (WebRTC pair à pair).
/// Seule la trace de l'appel est conservée : aucun flux audio ou vidéo ne transite par le serveur.
model Call {
  id           String     @id @default(cuid())
  mentorshipId String     @map("mentorship_id")
  callerId     String     @map("caller_id")
  calleeId     String     @map("callee_id")
  kind         CallKind
  status       CallStatus @default(RINGING)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  answeredAt   DateTime?  @map("answered_at") @db.Timestamptz(3)
  endedAt      DateTime?  @map("ended_at") @db.Timestamptz(3)

  mentorship Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  caller     User       @relation("CallCaller", fields: [callerId], references: [id], onDelete: Cascade)
  callee     User       @relation("CallCallee", fields: [calleeId], references: [id], onDelete: Cascade)
  message    Message?

  @@index([mentorshipId, createdAt])
  @@index([callerId, status])
  @@index([calleeId, status])
  @@map("calls")
}

// ─── Groupes d'accompagnement ───────────────────────────────────────────────

/// Groupe créé par un mentor pour accompagner plusieurs personnes ensemble (mentorés et mentors).
/// Le créateur en est aussi membre (ligne GroupMember) : l'accès se vérifie par l'appartenance.
model MentoringGroup {
  id          String   @id @default(cuid())
  ownerId     String   @map("owner_id")
  name        String   @db.VarChar(80)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner     User            @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members   GroupMember[]
  messages  GroupMessage[]
  workshops GroupWorkshop[]

  @@index([ownerId])
  @@map("mentoring_groups")
}

model GroupMember {
  groupId    String    @map("group_id")
  userId     String    @map("user_id")
  joinedAt   DateTime  @default(now()) @map("joined_at") @db.Timestamptz(3)
  /// Dernière lecture du fil : les messages postérieurs (des autres) sont non lus.
  lastReadAt DateTime? @map("last_read_at") @db.Timestamptz(3)

  group MentoringGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

model GroupMessage {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  senderId  String   @map("sender_id")
  /// Vide si le message ne porte qu'une pièce jointe.
  content   String
  hasFile   Boolean  @default(false) @map("has_file")
  /// Identifiant choisi par le navigateur : un message renvoyé après une coupure n'est pas dupliqué.
  clientId  String?  @map("client_id") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  group  MentoringGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sender User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  file   GroupMessageFile?

  @@unique([senderId, clientId])
  @@index([groupId, createdAt])
  @@map("group_messages")
}

/// Pièce jointe d'un message de groupe.
model GroupMessageFile {
  groupMessageId String   @id @map("group_message_id")
  fileName       String   @map("file_name") @db.VarChar(200)
  mimeType       String   @map("mime_type") @db.VarChar(120)
  size           Int
  data           Bytes
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  message GroupMessage @relation(fields: [groupMessageId], references: [id], onDelete: Cascade)

  @@map("group_message_files")
}

/// Atelier thématique (TDR, étape 4) : séance planifiée par le mentor responsable d'un groupe,
/// ouverte à tous ses membres. Annulation par cancelledAt (l'historique est conservé).
/// Invariants (CHECK SQL) : fin après le début, durée de 15 min à 4 h.
model GroupWorkshop {
  id          String    @id @default(cuid())
  groupId     String    @map("group_id")
  createdById String    @map("created_by_id")
  title       String    @db.VarChar(160)
  description String?   @db.VarChar(2000)
  startsAt    DateTime  @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime  @map("ends_at") @db.Timestamptz(3)
  modality    Modality  @default(REMOTE)
  meetingUrl  String?   @map("meeting_url") @db.VarChar(500)
  location    String?   @db.VarChar(200)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  group       MentoringGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attendances WorkshopAttendance[]

  @@index([groupId, startsAt])
  @@index([createdById, startsAt])
  @@map("group_workshops")
}

/// Réponse d'un membre du groupe (« je participe » ou non) : une par personne et par atelier.
model WorkshopAttendance {
  workshopId  String           @map("workshop_id")
  userId      String           @map("user_id")
  response    WorkshopResponse
  respondedAt DateTime         @default(now()) @map("responded_at") @db.Timestamptz(3)

  workshop GroupWorkshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workshopId, userId])
  @@index([userId])
  @@map("workshop_attendances")
}

// ─── Vérification des profils ───────────────────────────────────────────────

/// Demande examinée par l'équipe : justificatifs privés (la personne et les administrateurs seulement).
model VerificationRequest {
  id           String                    @id @default(cuid())
  userId       String                    @map("user_id")
  kind         VerificationKind
  status       VerificationRequestStatus @default(PENDING)
  /// Présentation du parcours ou motivation (candidature).
  message      String                    @db.VarChar(2000)
  /// Profil professionnel public (LinkedIn ou équivalent), facultatif.
  profileUrl   String?                   @map("profile_url") @db.VarChar(300)
  /// Motif de la décision (obligatoire en cas de refus), communiqué à la personne.
  decisionNote String?                   @map("decision_note") @db.VarChar(1000)
  decidedById  String?                   @map("decided_by_id")
  decidedAt    DateTime?                 @map("decided_at") @db.Timestamptz(3)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User                   @relation("VerificationApplicant", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?                  @relation("VerificationReviewer", fields: [decidedById], references: [id], onDelete: SetNull)
  documents VerificationDocument[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("verification_requests")
}

/// Justificatif (diplôme, attestation, certificat) : PDF ou image, 10 Mo au plus, 3 par demande.
model VerificationDocument {
  id        String   @id @default(cuid())
  requestId String   @map("request_id")
  fileName  String   @map("file_name") @db.VarChar(200)
  mimeType  String   @map("mime_type") @db.VarChar(120)
  size      Int
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  request VerificationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("verification_documents")
}

// ─── Objectifs & progression ────────────────────────────────────────────────

model Goal {
  id             String     @id @default(cuid())
  mentorshipId   String     @map("mentorship_id")
  createdById    String     @map("created_by_id")
  title          String     @db.VarChar(160)
  description    String?
  status         GoalStatus @default(NOT_STARTED)
  progress       Int        @default(0)
  dueDate        DateTime?  @map("due_date") @db.Timestamptz(3)
  mentorFeedback String?    @map("mentor_feedback")
  completedAt    DateTime?  @map("completed_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  mentorship Mentorship  @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  createdBy  User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  milestones Milestone[]

  @@index([mentorshipId])
  @@map("goals")
}

model Milestone {
  id        String    @id @default(cuid())
  goalId    String    @map("goal_id")
  title     String    @db.VarChar(160)
  isDone    Boolean   @default(false) @map("is_done")
  doneAt    DateTime? @map("done_at") @db.Timestamptz(3)
  sortOrder Int       @default(0) @map("sort_order")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, sortOrder])
  @@map("milestones")
}
